<!DOCTYPE html>
<html>
<head>
    <title>Gestión de Materias</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-4">
    <h1 class="mb-4 text-center">Gestion de materia</h1>
    <a href="/materias/crear" class="btn btn-success mb-3">Crear nueva materia</a>
    <table class="table table-bordered table-striped">
        <thead>
            <tr class="text-center">
                <th>ID</th>
                <th>Nombre</th>
                <th>Votos</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% materias.forEach(m => { %>
            <tr>
                <td><%= m.id %></td>
                <td><%= m.nombre %></td>
                <td><%= m.votos %></td>
                <td class="text-center">
                    <a href="/materias/editar/<%= m.id %>" class="btn btn-primary btn-sm">Editar</a>
                    <a href="/materias/eliminar/<%= m.id %>" class="btn btn-danger btn-sm">Eliminar</a>
                    <a href="/materias/votar/<%= m.id %>" class="btn btn-success btn-sm">+ votar</a>
                    <a href="/materias/desvotar/<%= m.id %>" class="btn btn-danger btn-sm">- votar</a>
                    <a href="/materias/<%= m.id %>/temas" class="btn btn-info btn-sm">Temas</a>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
</body>
</html>
